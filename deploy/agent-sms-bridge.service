[Unit]
Description=Agent SMS Bridge
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/agent-sms-bridge/venv/bin/agent-sms-bridge-server --config %h/.local/share/agent-sms-bridge/data/config.json
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/agent-sms-bridge/data

[Install]
WantedBy=default.target
